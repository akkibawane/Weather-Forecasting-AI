# ========================================================
# WeatherAI - Environment Configuration & API Keys
# ========================================================

# 1. OpenWeatherMap API Key (For Custom Map Layers: Precipitation, Temp, Wind, Clouds)
# -----------------------------------------------------------------------------------
# HOW TO GET A FREE KEY (Takes ~2 minutes):
# 1. Sign up for a free account at: https://home.openweathermap.org/users/sign_up
# 2. Go to "API keys" tab in your account dashboard.
# 3. Generate a key or copy your default key (32-character string).
# 4. Paste it below as VITE_OPENWEATHER_API_KEY=your_api_key_here
# Note: RainViewer live Doppler radar works right now out of the box with NO key!
VITE_OPENWEATHER_API_KEY=

# 2. Google Gemini API Key (Optional - For conversational AI Weather Assistant)
# -----------------------------------------------------------------------------------
# HOW TO GET A FREE KEY:
# 1. Visit Google AI Studio: https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Paste it below as VITE_GEMINI_API_KEY=your_api_key_here
# Note: WeatherAI has a built-in meteorological heuristic engine that works completely offline!
VITE_GEMINI_API_KEY=
